# Copy to .env and fill in your values

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://neondb_owner:your-password@ep-xxx-yyy.eu-west-1.aws.neon.tech/neondb?sslmode=require

# --- AI Providers ---
